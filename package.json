{
  "name": "claude-animated-shorts",
  "version": "1.0.0",
  "description": "Faceless YouTube Shorts production studio: Remotion + Three.js + Claude, 9:16 cartoon style",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "studio": "remotion studio",
    "build": "remotion bundle src/index.ts",
    "render": "remotion render src/index.ts",
    "render:test": "remotion render src/index.ts CartoonTest out/test.mp4 --codec h264 --crf 18",
    "render:test-2k": "remotion render src/index.ts CartoonTest out/test-2k.mp4 --codec h264 --crf 16 --scale 1.3333",
    "upgrade": "remotion upgrade"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scriptprohyper-stack/claude-animated-shorts"
  },
  "license": "MIT",
  "dependencies": {
    "@remotion/bundler": "4.0.411",
    "@remotion/cli": "4.0.411",
    "@remotion/renderer": "4.0.411",
    "@remotion/three": "4.0.411",
    "@react-three/fiber": "8.17.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.411",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.170.0",
    "typescript": "5.4.5"
  }
}
